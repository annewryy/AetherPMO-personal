{
  "name": "aetherpms-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AetherPMS 백엔드 서비스 v1 — 읽기 API + 테일러링 전개 + 스폰 + 전이 룰 엔진 (docs/design/0003)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
