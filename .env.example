# =============================================================================
# AetherPMO 환경변수 설정 가이드 (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase 데이터베이스 및 인증 설정 (필수)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 2. 로컬 추론 게이트웨이 및 Ollama LLM 설정
# -----------------------------------------------------------------------------
# [로컬 개발/단독 테스트 시]
# 로컬 게이트웨이 경유: http://127.0.0.1:11435
# 로컬 Ollama 직접 연결: http://127.0.0.1:11434
#
# [운영/Vercel 배포 환경 연결 시]
# 보안 터널 및 고정 호스트를 통해 노출된 실제 게이트웨이 URL을 입력하세요.
# (임의의 임시 터널 도메인 대신 실제 운영용 애플리케이션 호스트를 등록해야 합니다)
OLLAMA_BASE_URL=https://ai-gateway.your-domain.com

# 추론 모델명: qwen2.5:1.5b (공식 Apache License 2.0 준수, 16GB RAM/통합 GPU 최적화)
OLLAMA_MODEL=qwen2.5:1.5b

# 추론 타임아웃 (밀리초 단위, 기본 30000 = 30초)
OLLAMA_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# 3. Cloudflare Access Service Token (운영 배포 연결 시 필수 - REQUIRED)
# -----------------------------------------------------------------------------
# 운영 환경(Vercel)에서 PC 측 추론 게이트웨이로 요청할 때 비인가 접근을 원천 차단하기 위해
# Cloudflare Zero Trust의 Service Token을 필수로 검증합니다.
# 무토큰 요청(401) 또는 잘못된 토큰(403)은 게이트웨이에서 즉시 차단됩니다.
CF_ACCESS_CLIENT_ID=your-service-token-id.access
CF_ACCESS_CLIENT_SECRET=your-service-token-secret-value-long-random-string

# -----------------------------------------------------------------------------
# 4. PC 측 추론 게이트웨이 자체 설정 (PC 로컬 실행 시)
# -----------------------------------------------------------------------------
GATEWAY_PORT=11435
OLLAMA_LOCAL_URL=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# 5. Fastify 백엔드 서버 설정 (독립 Node 실행 시)
# -----------------------------------------------------------------------------
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# -----------------------------------------------------------------------------
# 6. 월투입공수 관리 (Monthly Effort) 이메일 발송 및 수신 설정
# -----------------------------------------------------------------------------
# [방법 A: 일반 회사 SMTP 메일 발송]
SMTP_HOST=smtp.your-company.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=pmo-survey@your-company.com
SMTP_PASS=your-smtp-password
SMTP_FROM="AetherPMO 사업관리실" <pmo-survey@your-company.com>

# [방법 B: Google Workspace / Gmail API]
# Google Cloud Console에서 서비스 계정 생성 및 Domain-Wide Delegation 설정 시
GOOGLE_WORKSPACE_CLIENT_EMAIL=aether-effort-bot@your-gsuite-project.iam.gserviceaccount.com
GOOGLE_WORKSPACE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# [방법 C: Microsoft 365 / Microsoft Graph API]
# Azure Portal의 앱 등록(App Registration)에서 발급한 앱 ID 및 Secret
MS_GRAPH_TENANT_ID=your-azure-tenant-id-uuid
MS_GRAPH_CLIENT_ID=your-azure-client-id-uuid
MS_GRAPH_CLIENT_SECRET=your-azure-client-secret-value

# [방법 D: 수신전용 웹훅 (SendGrid Inbound Parse, 사내 메일 웹훅)]
INBOUND_WEBHOOK_SECRET=your-secure-webhook-secret-token

