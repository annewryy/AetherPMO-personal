# =============================================================================
# AetherPMO 환경변수 설정 가이드 (.env.example)
# =============================================================================

# 1. Supabase 접속 설정 (필수)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Ollama 로컬 LLM 설정 (필수)
# 로컬 개발 환경: http://127.0.0.1:11434
# 운영/Vercel 배포 환경: Cloudflare Tunnel 또는 프록시 URL (예: https://ollama.your-domain.com)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 모델명: qwen2.5:1.5b (Apache License 2.0 준수, 16GB RAM/통합 GPU 최적화)
# 주의: qwen2.5:3b는 qwen-research 라이선스이므로 상업적 PMO 업무 시 1.5b 또는 llama3.2 권장
OLLAMA_MODEL=qwen2.5:1.5b

# 추론 타임아웃 (밀리초 단위, 기본 30초)
OLLAMA_TIMEOUT_MS=30000

# 3. 원격 터널 보안 인증 (Cloudflare Tunnel 사용 시 선택사항)
# 배포 환경에서 로컬 PC의 Ollama에 안전하게 접근할 때 Cloudflare Access Service Token 사용
# CF_ACCESS_CLIENT_ID=your-service-token-id.access
# CF_ACCESS_CLIENT_SECRET=your-service-token-secret

# 4. 서버 포트 및 CORS 설정 (Fastify 백엔드 실행 시)
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app
